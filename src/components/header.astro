---
import ThemeCycle from "./theme-cycle.astro";

const writing = Astro.url.pathname.startsWith("/blog");
---

<header class="site-header">
  <a class="identity" href="/" aria-label="Ricardo Corrales home"
    ><span class="brand-mark">rc.</span><span>Ricardo<br>Corrales</span></a
  >
  <nav aria-label="Main navigation">
    <a href="/#work">Work <span>01</span></a>
    <a href="/blog" aria-current={writing ? 'page' : undefined}
      >Writing <span>02</span></a
    >
    <a href="https://github.com/cmricardo">GitHub ↗</a>
    <ThemeCycle />
  </nav>
</header>
