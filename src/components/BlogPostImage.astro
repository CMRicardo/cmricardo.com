---
import { Image } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  width?: number;
  height?: number;
  [key: string]: any;
}

const { src, alt, width = 640, height = 360, ...attrs } = Astro.props;
---

<Image
  src={src}
  alt={alt}
  width={width}
  height={height}
  class="my-6 rounded-md max-h-96 w-full aspect-video"
  {...attrs}
/>
