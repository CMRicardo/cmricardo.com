---
import type { MarkdownInstance } from "astro";
import type { PostFrontmatter } from "../interfaces/post-frontmatter";
import ThemeAwareImage from "./theme-aware-image.astro";

interface Props {
  index: number;
  post: MarkdownInstance<PostFrontmatter>;
}
const { post, index } = Astro.props;
const {
  title,
  summary,
  date,
  tags = [],
  imageUrl,
  imageUrlDark,
  slug,
} = post.frontmatter;
---

<article class="archive-entry">
  <a class="archive-link" href={`/blog/${slug}`}>
    <span class="entry-number">{String(index + 1).padStart(2, '0')}</span>
    <div class="entry-copy">
      <div class="entry-meta">
        <time datetime={new Date(date).toISOString()}>{date}</time
        ><span>{tags.join(' / ')}</span>
      </div>
      <h2>{title}</h2>
      <p>{summary}</p>
      <span class="entry-cta"
        >Read the article <span aria-hidden="true">↗</span></span
      >
    </div>
    {imageUrl && <ThemeAwareImage alt="" class="entry-image" darkSrc={imageUrlDark} height="300" lightSrc={imageUrl} width="480" />}
  </a>
</article>
