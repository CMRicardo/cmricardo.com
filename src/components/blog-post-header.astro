---
import ThemeAwareImage from "@/components/theme-aware-image.astro";
import type { PostFrontmatter } from "../interfaces/post-frontmatter";

const { frontmatter } = Astro.props as { frontmatter: PostFrontmatter };
---

<header>
  <h2 class="text-2xl font-bold tracking-tight">{frontmatter.title}</h2>
  <span class="text-sm text-foreground/70">
    <span>{frontmatter.date}</span>
    -
    <span>{frontmatter.author}</span>
  </span>
  {frontmatter.imageUrl && (
      <ThemeAwareImage
        alt={frontmatter.title}
        class="mt-6 aspect-video rounded-md"
        darkSrc={frontmatter.imageUrlDark}
        height="1080"
        lightSrc={frontmatter.imageUrl}
        loading="eager"
        width="1920"
      />
    )}
</header>
