---
import { Image } from "astro:assets";

interface Props {
  alt: string;
  class?: string;
  darkSrc?: string;
  lightSrc: string;
  loading?: "eager" | "lazy";
  width?: number;
}

const {
  alt,
  class: className = "",
  darkSrc,
  lightSrc,
  loading = "lazy",
  width,
} = Astro.props;

const localImages = import.meta.glob<ImageMetadata>(
  "/src/assets/*.{png,webp}",
  {
    eager: true,
    import: "default",
  }
);
const lightImage = localImages[lightSrc];
const darkImage = darkSrc ? localImages[darkSrc] : undefined;

function imageWidth(image: ImageMetadata) {
  return Math.min(width ?? image.width, image.width);
}
---

<span
  class:list={[
    "theme-aware-image",
    darkImage && "theme-aware-image-has-dark",
    className,
  ]}
>
  <Image
    alt={alt}
    class="theme-aware-image-light"
    loading={loading}
    src={lightImage}
    width={imageWidth(lightImage)}
  />
  {darkImage && (
    <Image
      alt={alt}
      class="theme-aware-image-dark"
      loading={loading}
      src={darkImage}
      width={imageWidth(darkImage)}
    />
  )}
</span>

<style>
  .theme-aware-image {
    display: block;
    overflow: hidden;
  }

  .theme-aware-image > :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .theme-aware-image > :global(.theme-aware-image-dark) {
    display: none;
  }

  :global(.dark)
    .theme-aware-image-has-dark
    > :global(.theme-aware-image-light) {
    display: none;
  }

  :global(.dark)
    .theme-aware-image-has-dark
    > :global(.theme-aware-image-dark) {
    display: block;
  }
</style>
