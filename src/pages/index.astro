---
import type { MarkdownInstance } from "astro";
import ThemeAwareImage from "@/components/theme-aware-image.astro";
import type { PostFrontmatter } from "@/interfaces/post-frontmatter";
import Layout from "@/layouts/layout.astro";

const posts = Object.values(
  import.meta.glob<MarkdownInstance<PostFrontmatter>>("@/pages/blog/*.mdx", {
    eager: true,
  })
);
const orderedPosts = posts
  .sort(
    (a, b) =>
      new Date(b.frontmatter.date).getTime() -
      new Date(a.frontmatter.date).getTime()
  )
  .slice(0, 3);
---

<Layout className="flex flex-col gap-24">
  <section class="flex flex-col gap-2">
    <h2 class="text-2xl">Today</h2>
    <p>Building software at Grupo Comidas</p>
  </section>
  <section class="flex flex-col gap-2">
    <h2 class="text-2xl">Latest posts</h2>
    <ol class="grid gap-4">
      {orderedPosts.map((post) => (
        <li key={post.frontmatter.slug}>
          <a
            class="grid gap-3 rounded-md p-4 transition-colors hover:bg-primary/10 focus:outline-none focus-visible:bg-primary/10 sm:grid-cols-[minmax(0,1fr)_12rem] sm:items-center"
            href={`/blog/${post.frontmatter.slug}`}
            tabindex={0}
          >
            <section class="min-w-0">
              <h3 class="font-bold">{post.frontmatter.title}</h3>
              <p class="text-primary/80">{post.frontmatter.summary}</p>
              <span class="text-primary/80 text-sm">
                {post.frontmatter.date}
              </span>
            </section>
            {post.frontmatter.imageUrl && (
              <ThemeAwareImage
                alt={post.frontmatter.title}
                class="aspect-video rounded-md"
                darkSrc={post.frontmatter.imageUrlDark}
                height="100"
                lightSrc={post.frontmatter.imageUrl}
                width="200"
              />
            )}
          </a>
        </li>
      ))}
    </ol>
  </section>
</Layout>
