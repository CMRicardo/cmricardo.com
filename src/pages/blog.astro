---
import type { MarkdownInstance } from "astro";
import BlogArticle from "@/components/blog-article.astro";
import { WEBSITE_TITLE } from "@/constants";
import "@/styles/global.css";
import type { PostFrontmatter } from "@/interfaces/post-frontmatter";
import Layout from "@/layouts/layout.astro";

const posts = Object.values(
  import.meta.glob<MarkdownInstance<PostFrontmatter>>("@/pages/blog/*.mdx", {
    eager: true,
  })
);

posts.sort(
  (a, b) =>
    new Date(b.frontmatter.date).getTime() -
    new Date(a.frontmatter.date).getTime()
);
---

<Layout title={`Writing | ${WEBSITE_TITLE}`}>
  <section class="blog-intro">
    <span class="eyebrow">Writing / Field notes</span>
    <h1>Learning out loud.</h1>
    <p>
      Notes on building software, thoughtful interfaces,<br>and the things I
      figure out along the way.
    </p>
  </section>
  <section class="blog-archive" aria-label="All articles">
    <div class="archive-label">
      <span>Latest writing</span
      ><span>{posts.length.toString().padStart(2, '0')} articles</span>
    </div>
    {posts.map((post, index) => <BlogArticle {post} {index} />)}
  </section>
</Layout>
