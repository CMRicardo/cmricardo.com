---
import Analytics from "@vercel/analytics/astro";
import Header from "@/components/header.astro";
import "@/styles/global.css";
import "@/styles/portfolio.css";
import "@/styles/blog.css";
import Footer from "@/components/footer.astro";
import { WEBSITE_TITLE } from "@/constants.ts";

interface Props {
  className?: string;
  title?: string;
}
const { title = WEBSITE_TITLE, className = "" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8">
    <script is:inline>
      (() => {
        let preference = "system";
        try {
          preference = localStorage.getItem("theme") ?? "system";
        } catch {
          // Storage can be unavailable; follow the system theme.
        }
        document.documentElement.classList.toggle(
          "dark",
          preference === "dark" ||
            (preference !== "light" &&
              matchMedia("(prefers-color-scheme: dark)").matches)
        );
      })();
    </script>
    <meta name="viewport" content="width=device-width">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <meta name="generator" content={Astro.generator}>
    <title>{title}</title>
    <Analytics />
  </head>
  <body class="blog-site">
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main" class={`blog-main ${className}`}><slot /></main>
    <Footer />
  </body>
</html>
