---
import BlogPostHeader from "@/components/blog-post-header.astro";
import MarkdownContent from "@/components/markdown-content.astro";
import { WEBSITE_TITLE } from "@/constants";
import type { PostFrontmatter } from "@/interfaces/post-frontmatter";
import "@/styles/global.css";
import Layout from "@/layouts/layout.astro";

const { frontmatter } = Astro.props as { frontmatter: PostFrontmatter };
---

<Layout
  className="article-page"
  title={`${frontmatter.title} | Blog | ${WEBSITE_TITLE}`}
>
  <article>
    <BlogPostHeader {frontmatter} />
    <MarkdownContent><slot /></MarkdownContent>
    <div class="article-end">
      <span>Thanks for reading.</span><a href="/blog">More writing ↗</a>
    </div>
  </article>
</Layout>
